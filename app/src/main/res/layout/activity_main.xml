<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#202428">

    <!-- Hidden views kept for MainActivity.kt compatibility, not shown to the user -->

    <TextView
        android:id="@+id/statusText"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/logText"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />

    <View
        android:id="@+id/statusDot"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />

    <!-- Main Jarvis interface -->

    <FrameLayout
        android:id="@+id/micButton"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true">

        <com.jarvis.assistant.JarvisDialView
            android:id="@+id/jarvisDial"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Hidden: the word Jarvis is now drawn inside the hologram itself -->
        <TextView
            android:id="@+id/micIcon"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone" />

    </FrameLayout>

</FrameLayout>
