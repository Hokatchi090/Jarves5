<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#202428">

    <!--
        عناصر مخفية للإبقاء على توافق MainActivity
        بدون إظهار لوحة المحادثة القديمة.
    -->

    <TextView
        android:id="@+id/statusText"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/logText"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />

    <View
        android:id="@+id/statusDot"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />

    <!-- مركز واجهة جارفس -->

    <FrameLayout
        android:id="@+id/micButton"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true">

        <com.jarvis.assistant.JarvisDialView
            android:id="@+id/jarvisDial"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!--
            مخفي لأن كلمة جارفس أصبحت مرسومة
            داخل الهولوجرام نفسه.
        -->
        <TextView
            android:id="@+id/micIcon"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone" />

    </FrameLayout>

</FrameLayout>
