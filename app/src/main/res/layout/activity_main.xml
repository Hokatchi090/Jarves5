<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/app_background"
    android:padding="24dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingTop="32dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="\uD83E\uDD16"
            android:textSize="40sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="J A R V I S"
            android:textColor="@color/jarvis_accent"
            android:textSize="26sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:letterSpacing="0.25" />

        <View
            android:layout_width="140dp"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:background="@color/jarvis_accent" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/statusDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/status_dot" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="\u062C\u0627\u0647\u0632 \u0644\u0644\u0627\u0633\u062A\u0645\u0627\u0639"
                android:textColor="@color/jarvis_text_secondary"
                android:fontFamily="monospace"
                android:textSize="13sp" />
        </LinearLayout>

    </LinearLayout>

    <!-- Conversation log card -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/chat_card_background"
        android:padding="20dp">

        <TextView
            android:id="@+id/logText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/jarvis_text_primary"
            android:fontFamily="monospace"
            android:textSize="14sp"
            android:lineSpacingExtra="6dp" />
    </ScrollView>

    <!-- Mic button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingBottom="16dp">

        <Button
            android:id="@+id/micButton"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:background="@drawable/mic_button_background"
            android:elevation="12dp"
            android:text="\uD83C\uDF99\uFE0F"
            android:textSize="36sp"
            android:textColor="@color/jarvis_text_primary"
            android:includeFontPadding="false"
            android:stateListAnimator="@null" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="\u062F\u0648\u0633 \u0648\u0627\u062D\u0643\u064A \u00AB\u062C\u0627\u0631\u0641\u0633\u00BB \u0648\u0628\u0639\u062F\u0647\u0627 \u0627\u0644\u0623\u0645\u0631"
        android:textColor="@color/jarvis_text_secondary"
        android:fontFamily="monospace"
        android:textSize="12sp" />

</LinearLayout>
